# =============================================================================
# CAD Annotator — Git Ignore Rules
# =============================================================================

# Compiled output
dist/
tmp/
out-tsc/
*.tsbuildinfo

# Dependencies
node_modules/

# Environment variables (never commit secrets)
.env
.env.local
.env.*.local

# Kiro (internal development specs and config)
.kiro/

# IDE and editor files
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Build caches
.cache/
.local/

# Test coverage
coverage/

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# SQLite database (local dev fallback)
cad-annotator.db
cad-annotator.db-wal
cad-annotator.db-shm

# Lock files (pnpm only — enforced by preinstall hook)
package-lock.json
yarn.lock
